<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>laporan-2</title>
    <style>
        body {
            font-family: serif; /* Menggunakan font dengan kait (serif) seperti Times New Roman */
            background: none;   /* Tidak ada latar belakang (transparan) */
            margin: 0;          /* Menghilangkan margin bawaan browser */
            padding: 20px;      /* Memberi jarak dalam isi halaman */
        }
    
        /* Gaya untuk heading utama <h1> */
        h1 {
            background-color: #0000ff; /* Warna latar biru */
            color: #ffff00;            /* Warna teks kuning */
            padding: 15px;             /* Ruang dalam elemen */
            margin: 0;                 /* Hilangkan margin atas & bawah */
            font-size: 36px;           /* Ukuran huruf besar */
            box-shadow: 0px 4px 6px rgba(0,0,0,0.3); /* Bayangan di bawah elemen */
        }
    
        /* Gaya untuk heading kedua <h2> */
        h2 {
            color: #0000ff;   /* Warna teks biru */
            font-size: 36px;  /* Ukuran teks besar */
            margin-top: 30px; /* Jarak atas */
        }
    
        /* Gaya untuk paragraf */
        p {
            font-size: 18px;        /* Ukuran teks paragraf */
            line-height: 1.8;       /* Jarak antar baris */
            text-align: center;     /* Rata tengah isi teks */
            margin-top: 20px;       /* Jarak dari atas */
        }
    
        /* Kelas khusus untuk menyoroti teks dengan latar biru dan teks kuning */
        .highlight-blue {
            background-color: #0000ff; /* Latar biru */
            color: #ffff00;            /* Teks kuning */
            padding: 2px 4px;          /* Ruang di dalam elemen */
            border-radius: 3px;        /* Membuat sudut membulat */
        }
    
        /* Kelas khusus untuk menyoroti teks dengan latar kuning */
        .highlight-yellow {
            background-color: #ffff00; /* Latar kuning */
            padding: 2px 4px;          /* Padding dalam */
            border-radius: 3px;        /* Sudut membulat */
        }
    
        /* Gaya untuk tautan/link */
        a {
            color: black;             /* Warna teks hitam */
            text-decoration: none;   /* Menghilangkan garis bawah */
            font-size: 24px;         /* Ukuran teks besar */
            font-weight: bold;       /* Membuat teks tebal */
            display: inline-block;   /* Membuat link seperti blok kecil */
            margin-top: 30px;        /* Jarak dari atas */
            transition: 0.3s;        /* Efek transisi saat hover */
        }
    
        /* Efek saat tautan di-hover (disorot) */
        a:hover {
            color: #0000ff; /* Ubah warna teks jadi biru saat diarahkan kursor */
        }
    </style>
    
    
<body>
    <h3>Ini adalah laporan ke 2 dari matakuliah pemrograman web</h3>
    
    <!-- Warna teks adalah yellow(#ffff00) dan warna bg adalah blue(#0000ff) -->
    <h1 class="nama">Ida Ayu Satiya Siddhi Samhita</h1> 
    
    <!-- Warna teks adalah blue(#0000ff) -->
    <h2 id="nim">202332005</h2>

    <p>Lorem <i><span class="highlight-blue">ipsum</span></i> dolor sit amet consectetur adipisicing elit. 
        Sed quod fuga magni ipsa ipsam atque? Sed vero, quasi nemo illo ea maiores vel 
        itaque deserunt modi unde libero sunt debitis.</p>

    <!-- Warna bg adalah yellow(#ffff00) -->
    <p class="teks2">Lorem ipsum dolor sit <i><span class="highlight-yellow">amet</span></i>  consectetur adipisicing elit. 
        Suscipit est mollitia assumenda cum quisquam perferendis minima, unde fugit aspernatur itaque, 
        doloribus excepturi officia voluptatum adipisci alias provident error ipsa expedita.</p>

    <h3><a href="https://www.youtube.com/" target="_blank">Link menuju yutub</a></h3>
</body>
</html>
